# Copier ce fichier en .env puis remplir les valeurs (ne JAMAIS committer .env)

# --- PostgreSQL (entrepôt en étoile) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tenderiq
POSTGRES_USER=tenderiq
POSTGRES_PASSWORD=change_me
# Utilisateur en LECTURE SEULE utilisé par le Text-to-SQL
POSTGRES_READONLY_USER=tenderiq_ro
POSTGRES_READONLY_PASSWORD=change_me_ro

# --- Qdrant (base vectorielle) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=tdr_chunks

# --- LLM ---
# ollama (local, gratuit) ou api
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text
LLM_API_KEY=

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Langfuse (traces LLM) ---
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- API / sécurité ---
JWT_SECRET=change_me_long_random_string
JWT_EXPIRE_MINUTES=60

# --- E-mail (envoyé seulement après validation humaine) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=tenderiq@example.local

# --- Seuils qualité CI (LLMOps) ---
EVAL_RAG_MIN_SCORE=0.70
EVAL_SQL_MIN_ACCURACY=0.80
